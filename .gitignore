# Secrets and settings - never commit
.env
# Old copies kept by tools/usb.py load (may hold secrets / user data)
*.before-usb-*

# Python
__pycache__/
*.pyc
.venv/

# Your private test photos and generated results (names + scores)
backend/test_photos/*
!backend/test_photos/README.md
backend/results/

# Local databases
backend/data/
*.db
*.sqlite3

# Flutter / Android build output
app/build/
app/.dart_tool/
app/.flutter-plugins*
*.apk

# Editors / OS
.vscode/
.idea/
Thumbs.db
.DS_Store

# Design snapshots made by app/tool/design_shots_test.dart (regenerate any time)
app/tool/shots/

# App builds handed out by the server (tools/publish_app.py)
backend/public/

# Claude Code project notes (kept local, not on GitHub)
CLAUDE.md
.claude/
app/android/.kotlin/
