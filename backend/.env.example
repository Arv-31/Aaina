# Copy this file to ".env" and change values there. ".env" is never committed to Git.

# Face model: buffalo_s (fast, default) or buffalo_l (more accurate, ~10x slower on CPU).
# Switching models means everyone must re-enroll.
FACE_MODEL=buffalo_s

# Similarity cutoff. At or above = same person, below = "Unknown".
# Pick it with: .venv\Scripts\python tools\threshold_test.py
MATCH_THRESHOLD=0.38

# Faces narrower than this (in pixels) are rejected as too small / blurry
MIN_FACE_SIZE=60

# Detector input size: 320 (fast, works on tight phone crops) or 640 (finds faraway faces)
DET_SIZE=320

# ---------- Milestone 2: server ----------
# SQLite database file (inside backend/). Gitignored.
DB_PATH=data/aaina.db

# ---------- Milestone 3: database switch ----------
# sqlite   = one file (default). Works with no internet. To move it to the expo laptop use a
#            USB stick:  tools\usb.py save  (here)  then  tools\usb.py load  (there)
# supabase = free cloud Postgres (optional, needs internet). Then fill SUPABASE_DB_URL:
#            Supabase dashboard -> your project -> Connect -> "Session pooler" string
#            (works on normal IPv4 Wi-Fi), with [YOUR-PASSWORD] replaced by your password.
# Switching does NOT copy data: each database has its own users.
DB_BACKEND=sqlite
SUPABASE_DB_URL=
# Tables go in this schema, which Supabase's public REST API does not expose
DB_SCHEMA=aaina
# 0.0.0.0 lets the phone on the same hotspot reach the laptop
HOST=0.0.0.0
PORT=8000

# Logins
SESSION_DAYS=30
BORROWED_IDLE_MINUTES=10
ADMIN_SESSION_HOURS=8

# Admin login: DON'T type these by hand, run:  .venv\Scripts\python tools\setup_admin.py
ADMIN_ID=
ADMIN_PASSWORD_HASH=
ADMIN_TOTP_SECRET=

# Browser pages allowed to call the API (admin console). * = any, fine on a private hotspot
CORS_ORIGINS=*

# Enrollment quality check
ENROLL_MIN_PHOTOS=3
ENROLL_MAX_PHOTOS=5
BLUR_MIN=40
BRIGHTNESS_MIN=50
BRIGHTNESS_MAX=215
SAME_SET_MIN=0.30
MAX_UPLOAD_MB=6
